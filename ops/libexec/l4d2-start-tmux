#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_PATH=${L4D2_MAINTAIN_CONFIG:-/etc/l4d2-maintain.conf}
# shellcheck source=/dev/null
source "$CONFIG_PATH"

[[ $EUID -eq 0 ]] || {
    printf 'l4d2-start-tmux: must be launched through passwordless sudo\n' >&2
    exit 1
}

if [[ ${1:-} == --check && $# -eq 1 ]]; then
    exit 0
fi
[[ $# -eq 0 ]] || {
    printf 'Usage: l4d2-start-tmux [--check]\n' >&2
    exit 2
}

exec runuser -u "$SERVICE_USER" -- "$SERVER_ROOT/srcds_run" \
    -game left4dead2 \
    -console \
    -usercon \
    -tickrate "$TICKRATE" \
    +port "$PORT" \
    +sv_lan 0 \
    +map "$START_MAP"
