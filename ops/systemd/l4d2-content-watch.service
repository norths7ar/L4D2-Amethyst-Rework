[Unit]
Description=Restart L4D2 when stable VPK or SMX changes are pending and the server is empty
After=l4d2.service

[Service]
Type=oneshot
Environment=L4D2_RESTART_CONFIG=/etc/l4d2-restart.conf
ExecStart=/usr/local/sbin/l4d2-restart-if-needed
TimeoutStartSec=2min
