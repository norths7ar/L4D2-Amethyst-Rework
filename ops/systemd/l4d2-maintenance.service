# Managed by L4D2-Amethyst-Rework ops/install.sh
[Unit]
Description=Converge L4D2 Git, addon and maintenance state
After=network-online.target l4d2.service
Wants=network-online.target

[Service]
Type=oneshot
Environment=L4D2_MAINTAIN_CONFIG=/etc/l4d2-maintain.conf
ExecStart=/usr/local/sbin/l4d2-maintain converge
TimeoutStartSec=20min
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6
