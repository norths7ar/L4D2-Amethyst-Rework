# Installed as /etc/l4d2-restart.conf.
SERVICE_USER=l4d2
SERVICE_GROUP=l4d2
OWNER_USER=ecs-user
SERVICE_NAME=l4d2.service

SERVER_ROOT=/home/l4d2/server
GAME_DIR=/home/l4d2/server/left4dead2
RUNTIME_DIR=/run/l4d2

# Checkout B is updated by l4d2-update-and-restart and deployed into GAME_DIR (A).
CHECKOUT_ROOT=/home/l4d2/integration
CHECKOUT_BRANCH=main
CHECKOUT_REMOTE=origin

PORT=27015
START_MAP=c1m1_hotel
TICKRATE=100
HEALTH_STARTUP_TIMEOUT_SECONDS=60

# Keep Valve's crash backtrace path enabled while this server is under test.
# srcds_run writes its report here after a non-zero srcds_linux exit.
SRCDS_DEBUG=1
SRCDS_DEBUG_LOG=$SERVER_ROOT/debug.log

# Low-overhead host/process baseline collected by l4d2-observe.service.
OBSERVE_INTERVAL_SECONDS=5
OBSERVE_RETENTION_DAYS=7
OBSERVE_INCIDENT_LINES=7200
OBSERVE_BASELINE_MAX_BYTES=12582912
