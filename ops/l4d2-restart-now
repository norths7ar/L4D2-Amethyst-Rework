#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_PATH=${L4D2_RESTART_CONFIG:-/etc/l4d2-restart.conf}
LIBEXEC_DIR=${L4D2_LIBEXEC_DIR:-/usr/local/libexec/l4d2}
CONSOLE_TOOL="$LIBEXEC_DIR/l4d2-console"

[[ -r "$CONFIG_PATH" ]] || {
    printf 'l4d2-restart-now: cannot read %s\n' "$CONFIG_PATH" >&2
    exit 1
}
# shellcheck source=/dev/null
source "$CONFIG_PATH"

[[ $EUID -eq 0 ]] || {
    printf 'Usage: sudo l4d2-restart-now [reason]\n' >&2
    exit 1
}

reason=${*:-manual request}
reason=${reason//$'\n'/ }
reason=${reason//$'\t'/ }
actor=${SUDO_USER:-$(id -un)}

status_output=$("$CONSOLE_TOOL" status 2>/dev/null || true)
humans=$(sed -nE 's/^players[[:space:]]*:[[:space:]]*([0-9]+) humans.*/\1/p' \
    <<<"$status_output" | tail -n 1)
map=$(sed -nE 's/^map[[:space:]]*:[[:space:]]*([^[:space:]]+).*/\1/p' \
    <<<"$status_output" | tail -n 1)

logger -t l4d2-restart \
    "request actor=$actor map=${map:-unknown} humans=${humans:-unknown} reason=$reason"
systemctl restart "$SERVICE_NAME"

deadline=$((SECONDS + HEALTH_STARTUP_TIMEOUT_SECONDS))
while ((SECONDS < deadline)); do
    if systemctl is-active --quiet "$SERVICE_NAME" \
        && ss -lun "sport = :$PORT" | awk 'NR > 1 { found=1 } END { exit !found }' \
        && "$CONSOLE_TOOL" status >/dev/null 2>&1; then
        logger -t l4d2-restart "restart complete actor=$actor reason=$reason"
        printf 'l4d2-restart-now: restart complete\n'
        exit 0
    fi
    sleep 1
done

logger -t l4d2-restart \
    "restart failed health check actor=$actor reason=$reason"
printf 'l4d2-restart-now: service did not become healthy within %s seconds\n' \
    "$HEALTH_STARTUP_TIMEOUT_SECONDS" >&2
exit 1
