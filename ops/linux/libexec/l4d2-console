#!/usr/bin/env bash
set -Eeuo pipefail

CONFIG_PATH=${L4D2_RESTART_CONFIG:-/etc/l4d2-restart.conf}
if [[ ! -r "$CONFIG_PATH" ]]; then
    printf 'l4d2-console: cannot read %s\n' "$CONFIG_PATH" >&2
    exit 1
fi
# shellcheck source=/dev/null
source "$CONFIG_PATH"

runtime_kind() {
    local service_state
    service_state=$(systemctl is-active "$SERVICE_NAME" 2>/dev/null || true)
    case "$service_state" in
        active|activating|deactivating)
            printf 'systemd\n'
            return
            ;;
    esac
    if pgrep -u "$SERVICE_USER" -f '[s]rcds_linux' >/dev/null; then
        printf 'unmanaged\n'
        return
    fi
    printf 'stopped\n'
}

send_line() {
    local line=$1
    local runtime
    runtime=$(runtime_kind)
    case "$runtime" in
        systemd)
            [[ -p "$RUNTIME_DIR/console.fifo" ]] || {
                printf 'l4d2-console: console FIFO is missing\n' >&2
                return 1
            }
            timeout 3 bash -c 'printf "%s\n" "$1" > "$2"' _ "$line" "$RUNTIME_DIR/console.fifo"
            ;;
        *)
            printf 'l4d2-console: runtime is %s; no controllable console\n' "$runtime" >&2
            return 1
            ;;
    esac
}

query_status() {
    local marker="L4D2M$$_$(date +%s%N)"
    local since
    since=$(date '+%Y-%m-%d %H:%M:%S')
    [[ "$(runtime_kind)" == systemd ]] || {
        printf 'l4d2-console: server is not managed by active systemd\n' >&2
        return 1
    }
    send_line "echo ${marker}_BEGIN; status; echo ${marker}_END"

    if (
        set +o pipefail
        timeout 35 stdbuf -oL journalctl -u "$SERVICE_NAME" --since "$since" --follow \
            --no-pager -o cat \
            | awk -v begin="${marker}_BEGIN" -v end="${marker}_END" '
                index($0, begin) { capture=1; next }
                index($0, end) { if (capture) { done=1; exit } }
                capture { print }
                END { if (!done) exit 1 }
            '
    ); then
        return 0
    fi
    printf 'l4d2-console: timed out waiting for status output\n' >&2
    return 1
}

usage() {
    printf 'Usage: l4d2-console {runtime|status|quit}\n' >&2
    exit 2
}

case ${1:-} in
    runtime)
        runtime_kind
        ;;
    status)
        query_status
        ;;
    quit)
        send_line 'quit'
        for _ in {1..30}; do
            if ! pgrep -u "$SERVICE_USER" -f '[s]rcds_linux' >/dev/null; then
                exit 0
            fi
            sleep 1
        done
        printf 'l4d2-console: srcds did not exit after quit\n' >&2
        exit 1
        ;;
    *)
        usage
        ;;
esac
